# Hosted PostgreSQL. Do not use localhost in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="bravevest-9cced"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@bravevest-9cced.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="bravevest-9cced.firebasestorage.app"

# Deployment
FRONTEND_URL="https://bravevest-marketplace.vercel.app"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"

# Local alternative: absolute path to a service-account JSON file
# GOOGLE_APPLICATION_CREDENTIALS="C:\path\to\firebase-service-account.json"
