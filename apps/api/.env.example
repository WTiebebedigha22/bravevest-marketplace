# Supabase/PostgreSQL
# Use the Supabase pooler URL for DATABASE_URL at runtime.
# Add ?pgbouncer=true&connection_limit=1 when using transaction pooling.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the direct Supabase URL for Prisma migrations and db push.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Redis (required by Bull)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (replace both values before deploying)
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-token-secret"

FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# SMTP is optional during local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

TWO_FACTOR_APP_NAME=BraveVest