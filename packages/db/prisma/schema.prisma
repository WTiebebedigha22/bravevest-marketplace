generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String   @id @default(cuid())
  firebaseUid              String?  @unique
  email                    String   @unique
  phone                    String   @unique
  passwordHash             String
  role                     Role     @default(investor)
  accountType              AccountType @default(individual)
  
  // Personal Information
  firstName                String?
  lastName                 String?
  dateOfBirth              DateTime?
  
  // Business Information
  businessName             String?
  businessRegistrationNumber String?
  businessType             String?
  businessIndustry         String?
  businessAddress          String?
  yearsInOperation         Int?
  
  // Profile
  nationality              String?
  countryOfResidence       String?
  investorType             String?
  city                     String?
  address                  String?
  referralCode             String?
  taxId                    String?
  isPEP                    Boolean? @default(false)
  
  // Investment Preferences
  investmentExperience     String?
  riskTolerance            String?
  investmentGoals          String[]
  preferredSectors         String[]
  
  // 2FA
  isTwoFactorEnabled       Boolean  @default(false)
  twoFactorSecret          String?
  
  // KYC
  kycStatus                KycStatus @default(pending)
  kycVerifiedAt            DateTime?
  kycProvider              String?
  
  // Timestamps
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  lastLoginAt              DateTime?
  
  // Relations
  wallets                  Wallet[]
  subscriptions            Subscription[]
  auditLogs                AuditLog[]
  kycDocuments             KycDocument[]
  loanApplications         LoanApplication[]
  opportunities            Opportunity[]
  
  @@map("users")
}

model KycDocument {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  type        KycDocumentType
  storageKey  String
  status      KycDocumentStatus  @default(pending)
  reviewNote  String?
  expiresAt   DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
  @@map("kyc_documents")
}

model LoanApplication {
  id              String                @id @default(cuid())
  borrowerId      String
  borrower        User                  @relation(fields: [borrowerId], references: [id])
  requestedAmount Float
  purpose         String
  businessSummary String?
  status          LoanApplicationStatus @default(draft)
  reviewNote      String?
  reviewedAt      DateTime?
  opportunity     Opportunity?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([borrowerId, status])
  @@map("loan_applications")
}

model Opportunity {
  id                 String               @id @default(cuid())
  sponsorId          String
  sponsor            User                 @relation(fields: [sponsorId], references: [id])
  loanApplicationId  String?              @unique
  loanApplication    LoanApplication?    @relation(fields: [loanApplicationId], references: [id])
  title              String
  description        String?
  targetRaise        Float
  fundedAmount       Float                @default(0)
  unitPrice          Float
  totalUnits         Int
  minInvestment      Float
  maxInvestment      Float?
  tenureMonths       Int
  interestRate       Float
  projectedReturnPct Float
  riskRating         RiskRating
  status             OpportunityStatus   @default(draft)
  fundingDeadline    DateTime?
  maturityDate       DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  documents          OpportunityDocument[]
  subscriptions      Subscription[]
  repayments         Repayment[]

  @@index([status, riskRating])
  @@map("opportunities")
}

model OpportunityDocument {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  type          String
  storageKey    String
  createdAt     DateTime    @default(now())

  @@map("opportunity_documents")
}

model Repayment {
  id              String          @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id])
  installmentNo   Int
  dueDate         DateTime
  principalAmount Float
  interestAmount  Float
  amountPaid      Float           @default(0)
  status          RepaymentStatus @default(scheduled)
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([opportunityId, installmentNo])
  @@map("repayments")
}

model Wallet {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  balance           Float    @default(0)
  currency          String   @default("NGN")
  updatedAt         DateTime @updatedAt
  
  transactions      WalletTransaction[]
  
  @@map("wallets")
}

model WalletTransaction {
  id                  String   @id @default(cuid())
  walletId            String
  wallet              Wallet   @relation(fields: [walletId], references: [id])
  type                TransactionType
  amount              Float
  reference           String   @unique
  balanceAfter        Float
  relatedEntityType   String?
  relatedEntityId     String?
  metadata            Json?
  createdAt           DateTime @default(now())
  
  @@map("wallet_transactions")
}

model Subscription {
  id                String   @id @default(cuid())
  investorId        String
  investor          User     @relation(fields: [investorId], references: [id])
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])
  units             Int
  amount            Float
  status            SubscriptionStatus @default(pending)
  agreementDocUrl   String?
  subscribedAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  payouts           Payout[]
  
  @@map("subscriptions")
}

model Payout {
  id                String   @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  scheduledDate     DateTime
  amount            Float
  status            PayoutStatus @default(scheduled)
  paidAt            DateTime?
  transactionRef    String?
  
  @@map("payouts")
}

model AuditLog {
  id                String   @id @default(cuid())
  actorId           String
  actor             User     @relation(fields: [actorId], references: [id])
  action            String
  entity            String
  entityId          String?
  metadata          Json?
  createdAt         DateTime @default(now())
  
  @@map("audit_logs")
}

enum AccountType {
  individual
  business
}

enum Role {
  investor
  borrower
  admin
  committee
  support
}

enum KycStatus {
  pending
  verified
  rejected
}

enum TransactionType {
  deposit
  withdrawal
  subscription
  payout
  fee
}

enum SubscriptionStatus {
  pending
  active
  matured
  defaulted
}

enum PayoutStatus {
  scheduled
  paid
  failed
}

enum KycDocumentType {
  identity
  proof_of_address
  tax_document
  accreditation
  business_registration
}

enum KycDocumentStatus {
  pending
  approved
  rejected
  expired
}

enum LoanApplicationStatus {
  draft
  submitted
  under_review
  approved
  rejected
  converted
}

enum OpportunityStatus {
  draft
  under_review
  listed
  funding
  funded
  active
  completed
  defaulted
}

enum RiskRating {
  low
  medium
  high
}

enum RepaymentStatus {
  scheduled
  processing
  paid
  late
  defaulted
}